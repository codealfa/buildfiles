{
  "name": "akeeba/buildtools",
  "description": "Build utilities for Akeeba software",
  "license": "GPL-3.0-or-later",
  "minimum-stability": "beta",
  "require": {
    "php": "^8.1",
    "ext-zip": "*",
    "akeeba/s3": "dev-development",
    "composer/ca-bundle": "^1.2",
    "corneltek/getoptionkit": "^2.6.0",
    "czproject/git-php": "^4.0.3",
    "knplabs/github-api": "^3.0",
    "nyholm/psr7": "^1.0",
    "php-http/guzzle7-adapter": "^1.0",
    "rector/rector": "^0.10",
    "composer/semver": "^3.4.4"
  },
  "suggest": {
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*",
    "ext-ssh2": "*",
    "ext-xsl": "*",
    "ext-zlib": "*"
  },
  "autoload": {
    "psr-4" : {
      "Akeeba\\BuildFiles\\": "src"
    }
  },
  "config": {
    "platform" : {
      "php": "8.1.999"
    },
    "allow-plugins": {
      "rector/extension-installer": true,
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra" : {
    "dbxsl" : {
      "source": "https://github.com/docbook/xslt10-stylesheets/releases/download/release%2F1.79.2/docbook-xsl-1.79.2.zip"
    }
  },
  "scripts": {
    "npm-deps": [
      "npm install"
    ],
    "post-install-cmd": [
      "\\Akeeba\\BuildFiles\\Composer\\InstallationScript::installDbXsl",
      "@npm-deps"
    ],
    "post-update-cmd": [
      "\\Akeeba\\BuildFiles\\Composer\\InstallationScript::installDbXsl",
      "npm update",
      "@npm-deps"
    ],
    "pre-archive-cmd": [
      "@npm-deps"
    ],
    "post-create-project-cmd": [
      "\\Akeeba\\BuildFiles\\Composer\\InstallationScript::installDbXsl",
      "@composer dump-autoload -a"
    ]
  },
  "require-dev": {
    "phpcompatibility/php-compatibility": "10.0.0-alpha2",
    "phpcsstandards/phpcsutils": "^1.1.2",
    "squizlabs/php_codesniffer": "^3.13.3"
  }
}
