usage() {
  echo -e $COLOR_BROWN"Usage: %0 <command>"$COLOR_NC
  echo ""
  echo -e $COLOR_BLUE"All repositories"$COLOR_NC
  echo "pull	  Pull from Git"
  echo "push	  Push to Git"
  echo "tidy	  Perform local Git repo housekeeping"
  echo "status  Report repositories with uncommitted changes (use --files to list files)"
  echo "branch  Which branch am I in?"
  echo "cloneme Generate git clone commands"
  echo "version Latest version versus latest tag information"
  echo "tag     Latest Git tag and its date"
  echo "icopy   Copy a file into each first-level .idea directory"
  echo "install Hard-link this tool into all first-level subdirectories"
  echo -e $COLOR_BLUE"Using Akeeba Build Files"$COLOR_NC
  echo "build   Run the Phing 'git' task to rebuild the software"
  echo "link    Internal relink"
  echo "relink  Relink to a site, e.g. %0 relink /var/www/mysite"
  echo "update  Push updates to the CDN (uses Akeeba Release Maker)"

  exit 255
}

COLOR_NC='\033[0m'
COLOR_WHITE='\033[1;37m'
COLOR_BLACK='\033[0;30m'
COLOR_BLUE='\033[0;34m'
COLOR_LIGHT_BLUE='\033[1;34m'
COLOR_GREEN='\033[0;32m'
COLOR_LIGHT_GREEN='\033[1;32m'
COLOR_CYAN='\033[0;36m'
COLOR_LIGHT_CYAN='\033[1;36m'
COLOR_RED='\033[0;31m'
COLOR_LIGHT_RED='\033[1;31m'
COLOR_PURPLE='\033[0;35m'
COLOR_LIGHT_PURPLE='\033[1;35m'
COLOR_BROWN='\033[0;33m'
COLOR_YELLOW='\033[1;33m'
COLOR_GRAY='\033[0;30m'
COLOR_LIGHT_GRAY='\033[0;37m'

if [ $# -lt 1 ]; then
  usage

  exit 255
fi

STATUS_FILES=false

if [[ "$1" == "status" && "$2" == "--files" ]]; then
  STATUS_FILES=true
fi

print_status_files() {
  local status_line status file icon

  while IFS= read -r status_line; do
    status="${status_line:0:2}"
    file="${status_line:3}"

    if [[ "$status" == "??" ]]; then
      icon="❓"
    elif [[ "$status" == *"D"* ]]; then
      icon="❌"
    elif [[ "$status" == *"A"* ]]; then
      icon="✨"
    else
      icon="✏️"
    fi

    printf '   %s %s\n' "$icon" "$file"
  done
}

if [[ "$1" == "icopy" ]]; then
  if [ $# -ne 2 ]; then
    echo -e "${COLOR_LIGHT_RED}The icopy command requires a reference file.${COLOR_NC}" >&2
    exit 1
  fi

  if [[ ! -f "$2" ]]; then
    echo -e "${COLOR_LIGHT_RED}Reference file '$2' does not exist or is not a regular file.${COLOR_NC}" >&2
    exit 1
  fi

  REFERENCE_FILE="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"

  echo -e $COLOR_WHITE"All – Copying to .idea directories"$COLOR_NC
  echo ""

  find . -mindepth 1 -maxdepth 1 -type d -print0 |
  while IFS= read -r -d '' directory; do
    idea_directory="$directory/.idea"

    if [[ -d "$idea_directory" ]]; then
      echo -e "$COLOR_BROWN"Copying to "$COLOR_CYAN$idea_directory$COLOR_NC"
      cp -f "$REFERENCE_FILE" "$idea_directory/$(basename "$REFERENCE_FILE")"
    fi
  done

  exit 0
fi

if [[ "$1" == "install" ]]; then
  if [[ "$PWD" != "$HOME/Projects" ]] && [[ ! -d "akeeba" ]]; then
    echo -e "${COLOR_LIGHT_RED}The install command must be run from ~/Projects or from a directory that contains an 'akeeba' subdirectory.${COLOR_NC}"
    exit 1
  fi

  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  SCRIPT_PATH="$SCRIPT_DIR/all"
  echo -e $COLOR_WHITE"All – Installing hard links into first-level subdirectories"$COLOR_NC
  echo ""

  for d in *; do
    [[ ! -d "$d" ]] && continue
    [[ -L "$d" ]] && continue

    if [[ -d "$d/.git" ]]; then
      echo -e "$COLOR_CYAN$d$COLOR_NC ${COLOR_LIGHT_RED}not linked - not a tree of Git working copies${COLOR_NC}"
      continue
    fi

    HAS_GIT_SUBDIR=0
    for sub in "$d"/*/; do
      [[ -d "$sub" ]] || continue
      if [[ -d "${sub}.git" ]]; then
        HAS_GIT_SUBDIR=1
        break
      fi
    done
    if [[ $HAS_GIT_SUBDIR -eq 0 ]]; then
      echo -e "$COLOR_CYAN$d$COLOR_NC ${COLOR_LIGHT_RED}not linked - not a tree of Git working copies${COLOR_NC}"
      continue
    fi

    echo -en "$COLOR_CYAN$d$COLOR_NC "

    if [[ -e "$d/all" ]]; then
      rm -f "$d/all"
    fi

    if ln "$SCRIPT_PATH" "$d/all"; then
      echo -e "${COLOR_LIGHT_GREEN}linked${COLOR_NC}"
    else
      echo -e "${COLOR_LIGHT_RED}failed${COLOR_NC}"
    fi
  done

  exit 0
fi

echo -e $COLOR_WHITE"All – Loop all Git repositories"$COLOR_NC
echo ""

for d in *; do
  # Skip over files
  if [[ ! -d "$d" ]]; then
    continue
  fi

  # Skip over symlinks
  if [[ -L "$d" ]]; then
    continue
  fi

  # Make sure it's a Git repo
  if [ ! -d "$d/.git" ]; then
    continue
  fi

  # Go into the directory
  pushd $d >/dev/null

#  THISREPO_LINES=$(git remote -v | grep git@github.com | wc -l | awk '{print $1}')
#
#  if [ $THISREPO_LINES -lt 1 ]; then
#    popd >/dev/null
#
#    continue
#  fi

  case "$1" in
  pull)
    echo -e "\n"$COLOR_LIGHT_BLUE"Pulling $COLOR_CYAN$d"$COLOR_NC
    git pull --all -p -t --jobs=4
    ;;

  push)
    echo -e "\n"$COLOR_LIGHT_GREEN"Pushing $COLOR_CYAN$d"$COLOR_NC
    git push
    git push --tags
    ;;

  tidy)
    echo -e "\n"$COLOR_RED"Housekeeping $COLOR_CYAN$d"$COLOR_NC
    git remote prune origin
    git gc
    ;;

  cloneme)
    #ZZZ_CUR_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    ZZZ_CUR_BRANCH=$(git branch --show-current --abbrev)
    ZZZ_REMOTE=$(git config --get remote.origin.url)
    ZZZ_TAG=$(git describe --exact-match --tags 2>/dev/null)

    echo git clone --single-branch -b $ZZZ_CUR_BRANCH "$ZZZ_REMOTE" $d

    if [[ ! -z "$ZZZ_TAG" ]]
    then
      echo git -C $d switch -c $ZZZ_CUR_BRANCH
    fi
    ;;

  branch)
    ZZZ_CUR_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    ZZZ_COLOR=$COLOR_LIGHT_RED

    if [[ "$ZZZ_CUR_BRANCH" == "development" ]]; then
      ZZZ_COLOR=$COLOR_LIGHT_GREEN
    elif [[ "$ZZZ_CUR_BRANCH" == "master" ]]; then
      ZZZ_COLOR=$COLOR_YELLOW
    elif [[ "$ZZZ_CUR_BRANCH" == "main" ]]; then
      ZZZ_COLOR=$COLOR_YELLOW
    elif [[ "$ZZZ_CUR_BRANCH" == "kyrion" ]]; then
      ZZZ_COLOR=$COLOR_YELLOW
    fi

    echo -ne $COLOR_LIGHT_PURPLE"Branch "$COLOR_CYAN
    printf '%-25s' $d
    echo -e $ZZZ_COLOR$ZZZ_CUR_BRANCH$COLOR_NC
    ;;

  status)
    #i=`expr $(git status --porcelain 2>/dev/null| egrep "^(M| M)" | wc -l)`
    STATUS_OUTPUT=$(git status --porcelain 2>/dev/null)
    if [[ -n "$STATUS_OUTPUT" ]]; then
      echo -e $COLOR_LIGHT_RED"Dirty $COLOR_CYAN$d"$COLOR_NC

      if [[ "$STATUS_FILES" == true ]]; then
        printf '%s\n' "$STATUS_OUTPUT" | print_status_files
      fi
    fi
    ;;

  link)
    if [ -d build ]; then
      echo -e "\n"$COLOR_BROWN"Linking $COLOR_CYAN$d"$COLOR_NC
      cd build
      phing link
    fi
    ;;

  build)
    if [ -f build.xml ]; then
      echo -e "\n"$COLOR_BROWN"Building $COLOR_CYAN$d"$COLOR_NC
      phing git
    fi

    if [ -d build ]; then
      echo -e "\n"$COLOR_BROWN"Building $COLOR_CYAN$d"$COLOR_NC
      cd build
      phing git
    fi
    ;;

  relink)
    if [ -f build.xml ]; then
      echo -e "\n"$COLOR_BROWN"Relinking $COLOR_CYAN$d"$COLOR_NC
      phing relink -Dsite=$2
    fi

    if [ -d build ]; then
      echo -e "\n"$COLOR_BROWN"Relinking $COLOR_CYAN$d"$COLOR_NC
      cd build
      phing relink -Dsite=$2
    fi
    ;;

  update)
    if [ -f build.xml ]; then
      echo -e "\n"$COLOR_BROWN"Pushing updates for $COLOR_CYAN$d"$COLOR_NC
      phing update
    fi

    if [ -d build ]; then
      echo -e "\n"$COLOR_BROWN"Pushing updates for $COLOR_CYAN$d"$COLOR_NC
      cd build
      phing update
    fi
    ;;

  version)
    if [[ (! -f CHANGELOG.md) && (! -f CHANGELOG) ]]; then
      popd >/dev/null
      continue
    fi
    if [ -f CHANGELOG ]; then
      CHANGELOG_FILE=CHANGELOG
    else
      CHANGELOG_FILE=CHANGELOG.md
    fi
    LATEST_VERSION=$(grep -o "[[:blank:]]\([0-9]\{1,\}\.\)\{2\}\\\d\{1,\}" $CHANGELOG_FILE | head -n 1)
    LATEST_VERSION=$(echo $LATEST_VERSION | sed -e 's/^[[:space:]]*//')
    LATEST_TAG=$(git describe --abbrev=0 --always)

    if [[ "$LATEST_VERSION" != "$LATEST_TAG" ]]
    then
      echo -en "${COLOR_LIGHT_RED}Unreleased $COLOR_CYAN$d$COLOR_NC "
      echo -e "${COLOR_LIGHT_RED}$LATEST_VERSION$COLOR_NC ($COLOR_BROWN$LATEST_TAG$COLOR_NC)"
    else
      echo -en "${COLOR_LIGHT_GREEN}Released   $COLOR_CYAN$d$COLOR_NC "
      echo -e "$COLOR_BROWN$LATEST_TAG$COLOR_NC"
    fi
    ;;

  tag)
    LATEST_TAG=$(git for-each-ref --sort=-taggerdate refs/tags/ --format '%(refname:short) -- %(taggerdate:relative)' | head -n 1)
    echo -e "$COLOR_CYAN$d$COLOR_NC $LATEST_TAG"
    ;;

  *)
    echo Unknown command "$1"

    popd >/dev/null

    exit
    ;;
  esac

  popd >/dev/null
done
